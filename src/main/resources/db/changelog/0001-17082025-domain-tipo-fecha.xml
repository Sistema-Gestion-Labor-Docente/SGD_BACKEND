<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

  <changeSet id="0001-17082025-domain-tipo-fecha" author="Jesus Edwin Adrada Ruiz">
    <preConditions onFail="MARK_RAN">
      <sqlCheck expectedResult="0">
        SELECT COUNT(*) FROM pg_type WHERE typname = lower('tipo_fecha')
      </sqlCheck>
    </preConditions>

    <sql>
      CREATE DOMAIN TIPO_FECHA AS VARCHAR(50);
    </sql>

    <rollback>
      <sql>DROP DOMAIN IF EXISTS TIPO_FECHA CASCADE;</sql>
    </rollback>
  </changeSet>
</databaseChangeLog>
