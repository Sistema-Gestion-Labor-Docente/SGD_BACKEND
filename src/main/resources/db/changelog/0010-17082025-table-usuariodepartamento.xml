<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

  <changeSet id="0010-17082025-usuariodepartamento" author="Jesus Edwin Adrada Ruiz">
    <createTable tableName="USUARIODEPARTAMENTO">
      <column name="OIDUSUARIO" type="INT">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="OIDDEPARTAMENTO" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="FECHACREACION" type="TIMESTAMP">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addForeignKeyConstraint
        baseTableName="USUARIODEPARTAMENTO" baseColumnNames="OIDUSUARIO"
        referencedTableName="USUARIO" referencedColumnNames="OIDUSUARIO"
        constraintName="FK_USRDEP_USR"/>

    <addForeignKeyConstraint
        baseTableName="USUARIODEPARTAMENTO" baseColumnNames="OIDDEPARTAMENTO"
        referencedTableName="DEPARTAMENTO" referencedColumnNames="OIDDEPARTAMENTO"
        constraintName="FK_USRDEP_DEP"/>
  </changeSet>
</databaseChangeLog>
