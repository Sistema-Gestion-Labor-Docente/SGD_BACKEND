<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">
    <changeSet id="0015-09092025-usuario-actividad-calendario" author="Jesus Edwin Adrada Ruiz">
        <createSequence sequenceName="SEQ_OIDUSUARIOACTIVIDADCALENDARIO" startValue="1" incrementBy="1"/>

        <createTable tableName="USUARIOACTIVIDADCALENDARIO">
            <column name="OIDUSUARIOACTIVIDADCALENDARIO" type="INT" defaultValueComputed="nextval('SEQ_OIDUSUARIOACTIVIDADCALENDARIO')">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="OIDUSUARIO" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="OIDACTIVIDAD" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="OIDCALENDARIO" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="FECHACREACION" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="FECHAACTUALIZACION" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
            constraintName="FK_UAC_USUARIO"
            baseTableName="USUARIOACTIVIDADCALENDARIO"
            baseColumnNames="OIDUSUARIO"
            referencedTableName="USUARIO"
            referencedColumnNames="OIDUSUARIO"
            onDelete="RESTRICT"
            onUpdate="RESTRICT"/>

        <addForeignKeyConstraint
            constraintName="FK_UAC_ACTIVIDAD"
            baseTableName="USUARIOACTIVIDADCALENDARIO"
            baseColumnNames="OIDACTIVIDAD"
            referencedTableName="ACTIVIDAD"
            referencedColumnNames="OIDACTIVIDAD"
            onDelete="RESTRICT"
            onUpdate="RESTRICT"/>

        <addForeignKeyConstraint
            constraintName="FK_UAC_CALENDARIO"
            baseTableName="USUARIOACTIVIDADCALENDARIO"
            baseColumnNames="OIDCALENDARIO"
            referencedTableName="CALENDARIO"
            referencedColumnNames="OIDCALENDARIO"
            onDelete="RESTRICT"
            onUpdate="RESTRICT"/>

        <createSequence sequenceName="SEQ_OIDUSUARIOACTIVIDADCALENDARIO"
                    startValue="1" incrementBy="1"/>

        <addUniqueConstraint
            tableName="USUARIOACTIVIDADCALENDARIO"
            columnNames="OIDUSUARIO,OIDACTIVIDAD,OIDCALENDARIO"
            constraintName="UQ_USUARIO_ACTIVIDAD_CALENDARIO"/>
    </changeSet>
</databaseChangeLog>