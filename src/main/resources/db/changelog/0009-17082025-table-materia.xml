<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

  <changeSet id="0009-17082025-materia" author="Jesus Edwin Adrada Ruiz">
    <createTable tableName="MATERIA">
      <column name="IDMATERIA" type="INT" defaultValueComputed="nextval('SEQ_IDMATERIA')">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="OIDMATERIA" type="VARCHAR(50)">
        <constraints nullable="false"/>
      </column>
      <column name="CODIGO" type="VARCHAR(50)">
        <constraints nullable="false"/>
      </column>
      <column name="NOMBRE" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="SEMESTRE" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="HORASSEMANA" type="INT"/>
      <column name="OIDDEPARTAMENTO" type="INT"/>
      <column name="OIDPLAN" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="CORREQUISITO_IDMATERIA" type="INT"/>
      <column name="FECHACREACION" type="TIMESTAMP" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
      <column name="USUARIOCREACION" type="VARCHAR(100)">
        <constraints nullable="false"/>
      </column>
      <column name="FECHAACTUALIZACION" type="TIMESTAMP"/>
      <column name="USUARIOACTUALIZACION" type="VARCHAR(100)"/>
    </createTable>

    <addUniqueConstraint tableName="MATERIA" columnNames="OIDMATERIA" constraintName="UQ_MATERIA_OID"/>
    <addUniqueConstraint tableName="MATERIA" columnNames="CODIGO"     constraintName="UQ_MATERIA_CODIGO"/>
    <addUniqueConstraint tableName="MATERIA" columnNames="NOMBRE"     constraintName="UQ_MATERIA_NOMBRE"/>

    <!-- Checks vía SQL -->
    <sql>
      ALTER TABLE MATERIA
      ADD CONSTRAINT CK_MATERIA_SEMESTRE CHECK (SEMESTRE &gt;= 1);
    </sql>
    <sql>
      ALTER TABLE MATERIA
      ADD CONSTRAINT CK_MATERIA_CORR_DIFF
      CHECK (CORREQUISITO_IDMATERIA IS NULL OR CORREQUISITO_IDMATERIA &lt;&gt; IDMATERIA);
    </sql>

    <addForeignKeyConstraint
        baseTableName="MATERIA" baseColumnNames="OIDDEPARTAMENTO"
        referencedTableName="DEPARTAMENTO" referencedColumnNames="OIDDEPARTAMENTO"
        constraintName="FK_MATERIA_DEPARTAMENTO"/>

    <addForeignKeyConstraint
        baseTableName="MATERIA" baseColumnNames="OIDPLAN"
        referencedTableName="PLAN" referencedColumnNames="OIDPLAN"
        constraintName="FK_MATERIA_PLAN"/>

    <addForeignKeyConstraint
        baseTableName="MATERIA" baseColumnNames="CORREQUISITO_IDMATERIA"
        referencedTableName="MATERIA" referencedColumnNames="IDMATERIA"
        constraintName="FK_MATERIA_CORR"/>

  </changeSet>
</databaseChangeLog>
